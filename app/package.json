{
  "name": "golden-shine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Golden Shine Cleaning Service — landing, scheduling form and admin panel (React + Vite + Firebase).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions run test",
    "functions:test:coverage": "npm --prefix functions run test:coverage",
    "functions:test:integration": "npm --prefix functions run test:integration",
    "deploy:functions": "firebase deploy --only functions:mail",
    "lint:tests": "tsc -p tsconfig.test.json --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-goldenshine 'vitest run test/rules --config vitest.rules.config.ts'",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-goldenshine"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "firebase": "^11.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^13.29.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
